# HomeHunt localhost API settings
# Copy this file to .env. Never commit the real .env file.

# Required for official apartment sale/rent transactions and home-supply notices.
# Apply separately for the ApplyHome and LH Open APIs; the same data.go.kr key
# can be reused after each service approves the application.
# Prefer the Decoding/raw key shown by data.go.kr.
MOLIT_SERVICE_KEY=YOUR_DATA_GO_KR_DECODING_KEY

# Used by the localhost server for NAVER Directions 5.
# The same Maps Application can enable Dynamic Map, Geocoding,
# Reverse Geocoding, and Directions 5. If you issue a new Client ID,
# also update APP_CONFIG.naverMapClientId in js/config.js.
# Never put the Client Secret in browser code.
NAVER_MAPS_CLIENT_ID=YOUR_NAVER_MAPS_CLIENT_ID
NAVER_MAPS_CLIENT_SECRET=YOUR_NAVER_MAPS_CLIENT_SECRET

# Required for broad company, store, institution, and branch-name search.
# These credentials currently use an existing NAVER Developers Application
# with Search enabled. Existing keys are supported only through 2027-06-30;
# migrate this adapter and credentials to NAVER API HUB before then.
NAVER_LOCAL_SEARCH_CLIENT_ID=YOUR_NAVER_DEVELOPERS_CLIENT_ID
NAVER_LOCAL_SEARCH_CLIENT_SECRET=YOUR_NAVER_DEVELOPERS_CLIENT_SECRET

# Preferred for bus and subway travel-time verification.
# One Kakao REST API key is used only by the localhost server. Only upstream
# attempts count toward the KST-day local safety limit. Kakao route results
# are live-only: completed responses are not cached or written to disk.
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_DAILY_LIMIT=1000

# Transit provider selection: auto (Kakao if configured, otherwise TMAP), kakao,
# or tmap. Each selected provider can finish verification on its own.
TRANSIT_PROVIDER=auto

# TMAP is the fallback transit provider. Its FREE summary API currently allows
# only 10 upstream calls per KST day, so HomeHunt keeps a local usage ledger.
TMAP_APP_KEY=YOUR_TMAP_TRANSIT_APP_KEY
TMAP_DAILY_LIMIT=10

# TMAP cache must be greater than 0 and less than 24 hours. This does not enable
# a Kakao response cache. Parallel calls are conservative to avoid bursts.
TRANSIT_CACHE_HOURS=8
TRANSIT_CONCURRENCY=2

# This must stay 8787 unless js/config.js is changed to the same port.
HOMEHUNT_LOCAL_API_PORT=8787
