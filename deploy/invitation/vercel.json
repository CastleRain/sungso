{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/wedding.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"sungso-wedding.ics\"" }
      ]
    },
    {
      "source": "/assets/audio/(.*)",
      "headers": [{ "key": "Content-Type", "value": "audio/mpeg" }]
    },
    {
      "source": "/v6/wedding.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"sungso-wedding.ics\"" }
      ]
    },
    {
      "source": "/v6/assets/audio/(.*)",
      "headers": [{ "key": "Content-Type", "value": "audio/mpeg" }]
    }
  ]
}
