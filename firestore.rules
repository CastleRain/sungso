rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function siteMember() {
      return googleUser()
        && exists(/databases/$(database)/documents/site_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/site_members/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/site_members/$(request.auth.uid)).data.role in ['sungwoo', 'sohee'];
    }
    function memberRole() {
      return get(/databases/$(database)/documents/site_members/$(request.auth.uid)).data.role;
    }
    // Only administrators can grant membership. Clients read only their own status.
    match /site_members/{uid} {
      allow get: if googleUser() && request.auth.uid == uid;
      allow list, write: if false;
    }
    function validHomehuntSnapshot(uid) {
      let next = request.resource.data;
      return next.keys().hasOnly(['snapshot', 'revision', 'updatedAt', 'updatedBy'])
        && next.updatedBy == uid
        && next.updatedAt is string && next.updatedAt.size() <= 30
        && next.revision is int && next.revision > 0
        && next.snapshot is map
        && next.snapshot.keys().hasOnly(['schemaVersion', 'recommendationFilters', 'visits', 'shortlist', 'compareIds', 'supplyFavorites', 'parkingObservations'])
        && next.snapshot.schemaVersion == 1
        && next.snapshot.recommendationFilters is map
        && next.snapshot.visits is list && next.snapshot.visits.size() <= 1000
        && next.snapshot.shortlist is list && next.snapshot.shortlist.size() <= 1000
        && next.snapshot.compareIds is list && next.snapshot.compareIds.size() <= 3
        && next.snapshot.supplyFavorites is list && next.snapshot.supplyFavorites.size() <= 1000
        && next.snapshot.parkingObservations is map;
    }
    match /homehunt_user_snapshots/{uid} {
      allow get: if siteMember() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if siteMember() && request.auth.uid == uid
        && validHomehuntSnapshot(uid) && request.resource.data.revision == 1;
      allow update: if siteMember() && request.auth.uid == uid
        && validHomehuntSnapshot(uid) && request.resource.data.revision == resource.data.revision + 1;
    }
    // Admin SDK server state is never accessible to browser clients.
    match /homehunt_members/{document=**} { allow read, write: if false; }
    match /homehunt_households/{document=**} { allow read, write: if false; }
    match /homehunt_route_cache/{document=**} { allow read, write: if false; }
    match /homehunt_provider_usage/{document=**} { allow read, write: if false; }
    match /homehunt_request_limits/{document=**} { allow read, write: if false; }
    match /homehunt_kapt_source_cache/{document=**} { allow read, write: if false; }
    match /homehunt_maintenance/{document=**} { allow read, write: if false; }
    match /homehunt_jobs/{document=**} { allow read, write: if false; }
    match /homehunt_job_lookups/{document=**} { allow read, write: if false; }
    match /travel_places/{document=**} { allow read, write: if false; }
    match /homehunt_apartment_cache/{document=**} { allow read, write: if false; }
    match /homehunt_molit_month_cache/{document=**} { allow read, write: if false; }
    match /homehunt_api_limits/{document=**} { allow read, write: if false; }
    match /server_api_limits/{document=**} { allow read, write: if false; }
    match /naver_blog_cache/{document} { allow read: if siteMember(); allow write: if false; }
    match /naver_blog_meta/{document} { allow read: if siteMember(); allow write: if false; }
    match /private_data/{document} { allow read: if siteMember(); allow write: if false; }
    match /private_files/{document} { allow read: if siteMember(); allow write: if false; }

    function validGroup(group) {
      return group is map && group.keys().hasOnly(['id', 'name'])
        && group.id in ['daily', 'wedding', 'travel']
        && group.name is string && group.name.size() > 0 && group.name.size() <= 30;
    }
    function validHomeApp(app) {
      return app is map && app.keys().hasOnly(['id', 'groupId', 'hidden'])
        && app.id in ['dates', 'homehunt', 'wecost', 'invitation', 'travel', 'honeymoon']
        && app.groupId in ['daily', 'wedding', 'travel'] && app.hidden is bool;
    }
    function validHome() {
      let next = request.resource.data;
      return next.keys().hasOnly(['groups', 'apps', 'revision', 'updatedBy', 'updatedAt'])
        && next.updatedBy == request.auth.uid && next.updatedAt == request.time
        && next.revision is int && next.revision > 0
        && next.groups is list && next.groups.size() == 3
        && validGroup(next.groups[0]) && validGroup(next.groups[1]) && validGroup(next.groups[2])
        && [next.groups[0].id, next.groups[1].id, next.groups[2].id].hasAll(['daily', 'wedding', 'travel'])
        && next.apps is list && next.apps.size() == 6
        && validHomeApp(next.apps[0]) && validHomeApp(next.apps[1]) && validHomeApp(next.apps[2])
        && validHomeApp(next.apps[3]) && validHomeApp(next.apps[4]) && validHomeApp(next.apps[5])
        && [next.apps[0].id, next.apps[1].id, next.apps[2].id, next.apps[3].id, next.apps[4].id, next.apps[5].id]
          .hasAll(['dates', 'homehunt', 'wecost', 'invitation', 'travel', 'honeymoon']);
    }
    match /site_home/shared {
      allow read: if siteMember();
      allow create: if siteMember() && validHome() && request.resource.data.revision == 1;
      allow update: if siteMember() && validHome() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /home_notes/{noteId} {
      allow read: if siteMember();
      allow create: if siteMember()
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if siteMember() && resource.data.authorUid == request.auth.uid;
    }

    match /events/{document} { allow read, write: if siteMember(); }
    match /wecost_settings/{document} { allow read, write: if siteMember(); }
    match /wecost_savings/{document} { allow read, write: if siteMember(); }
    match /wecost_items/{document} { allow read, write: if siteMember(); }
    match /wecost_loans/{document} { allow read, write: if siteMember(); }
    match /wecost_adjustments/{document} { allow read, write: if siteMember(); }
    match /honeymoon_fx/{document} { allow read, write: if siteMember(); }
    match /blog_review_prefs/{document} { allow read, write: if siteMember(); }
    match /resort_note_meta/{document} { allow read, write: if siteMember(); }
    match /resort_images/{document} { allow read, write: if siteMember(); }
    match /resort_notes/{resortId}/comments/{commentId} { allow read, write: if siteMember(); }

    // Shared invitation content is independent of the existing design choice.
    function invitationPhotoId(id) {
      return id is string && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
    }
    function invitationGallerySlot(values, index) {
      return values.size() <= index || invitationPhotoId(values[index]);
    }
    function invitationGallery(values) {
      return values is list && values.size() <= 20 && values.toSet().size() == values.size()
        && invitationGallerySlot(values, 0) && invitationGallerySlot(values, 1)
        && invitationGallerySlot(values, 2) && invitationGallerySlot(values, 3)
        && invitationGallerySlot(values, 4) && invitationGallerySlot(values, 5)
        && invitationGallerySlot(values, 6) && invitationGallerySlot(values, 7)
        && invitationGallerySlot(values, 8) && invitationGallerySlot(values, 9)
        && invitationGallerySlot(values, 10) && invitationGallerySlot(values, 11)
        && invitationGallerySlot(values, 12) && invitationGallerySlot(values, 13)
        && invitationGallerySlot(values, 14) && invitationGallerySlot(values, 15)
        && invitationGallerySlot(values, 16) && invitationGallerySlot(values, 17)
        && invitationGallerySlot(values, 18) && invitationGallerySlot(values, 19);
    }
    function invitationText(value, limit) {
      return value is string && value.size() <= limit
        && value.matches('[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*');
    }
    function invitationMapUrl(value) {
      return invitationText(value, 1000)
        && (value == '' || value.matches('https://[^\\s/@:\\\\]+(:[0-9]+)?([/?#][^\\s\\\\]*)?'));
    }
    function invitationVenue(venue) {
      return venue is map && venue.keys().hasOnly(['name', 'hall', 'address', 'mapUrl', 'naverUrl', 'kakaoUrl', 'transport', 'parking'])
        && invitationText(venue.name, 80) && invitationText(venue.hall, 80)
        && invitationText(venue.address, 300) && invitationMapUrl(venue.mapUrl)
        && invitationMapUrl(venue.get('naverUrl', '')) && invitationMapUrl(venue.get('kakaoUrl', ''))
        && invitationText(venue.transport, 1000) && invitationText(venue.parking, 1000)
        && (venue.name.matches('.*\\S.*') || (venue.name == '' && venue.hall == '' && venue.address == '' && venue.mapUrl == '' && venue.get('naverUrl', '') == '' && venue.get('kakaoUrl', '') == '' && venue.transport == '' && venue.parking == ''));
    }
    function validInvitationProfile(next) {
      return next.keys().hasOnly(['schemaVersion', 'revision', 'coverId', 'galleryIds', 'mapImageId', 'venue', 'updatedAt', 'updatedBy'])
        && next.schemaVersion == 1 && next.revision is int && next.revision > 0
        && (next.coverId == null || invitationPhotoId(next.coverId))
        && (next.get('mapImageId', null) == null || invitationPhotoId(next.mapImageId))
        && invitationGallery(next.galleryIds) && invitationVenue(next.venue)
        && next.updatedBy == request.auth.uid && next.updatedAt == request.time;
    }
    match /invitation_settings/shared {
      allow get: if siteMember();
      allow list, delete: if false;
      allow create: if siteMember() && validInvitationProfile(request.resource.data) && request.resource.data.revision == 1;
      allow update: if siteMember() && validInvitationProfile(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
    }
    function invitationReferences(profile, id) {
      return profile.coverId == id || id in profile.galleryIds || profile.get('mapImageId', null) == id;
    }
    // Every photo write must accompany a new shared revision. Immutable IDs
    // let readers finish loading all referenced photos before publishing it.
    function invitationProfileCommit() {
      let path = /databases/$(database)/documents/invitation_settings/shared;
      let next = getAfter(path).data;
      return next.updatedBy == request.auth.uid && next.updatedAt == request.time
        && next.revision == (exists(path) ? get(path).data.revision + 1 : 1);
    }
    function validInvitationPhoto(next) {
      return next.keys().hasOnly(['dataUrl', 'width', 'height', 'updatedAt', 'updatedBy'])
        && next.dataUrl is string && next.dataUrl.size() <= 360000
        && next.dataUrl.matches('data:image/(jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}')
        && (next.dataUrl.size() - 23) % 4 == 0
        && next.width is int && next.width > 0 && next.width <= 4096
        && next.height is int && next.height > 0 && next.height <= 4096
        && next.updatedBy == request.auth.uid && next.updatedAt == request.time;
    }
    match /invitation_settings/shared/photos/{photoId} {
      allow get: if siteMember();
      allow list, update: if false;
      allow create: if siteMember() && invitationPhotoId(photoId) && validInvitationPhoto(request.resource.data)
        && invitationProfileCommit()
        && invitationReferences(getAfter(/databases/$(database)/documents/invitation_settings/shared).data, photoId);
      allow delete: if siteMember() && invitationProfileCommit()
        && invitationReferences(get(/databases/$(database)/documents/invitation_settings/shared).data, photoId)
        && !invitationReferences(getAfter(/databases/$(database)/documents/invitation_settings/shared).data, photoId);
    }

    function validFavorites(values) {
      return values is list && values.size() <= 29
        && values.hasOnly(['minimal', 'letter', 'photo', 'garden', 'cinema', 'sketch',
          'envelope', 'constellation', 'camera', 'storybook', 'ticket', 'curtain',
          'magazine', 'film', 'vinyl', 'museum', 'greenhouse', 'scrapbook', 'festival', 'promenade',
          'paper-theater', 'memory-house', 'ribbon',
          'salon-lettering', 'salon-polaroid', 'salon-editorial', 'guest-seoul', 'guest-porto', 'guest-jeju']);
    }
    function ownFavorites(next, previous) {
      return next is map && next.keys().hasOnly(['sungwoo', 'sohee'])
        && next.diff(previous).affectedKeys().hasOnly([memberRole()])
        && validFavorites(next.get(memberRole(), []));
    }
    function validInvitation(next) {
      return next.keys().hasOnly(['schemaVersion', 'favorites', 'selection', 'selectionRevision', 'updatedBy', 'updatedAt'])
        && next.schemaVersion == 1
        && next.updatedBy == request.auth.uid && next.updatedAt == request.time;
    }
    function validSelection(next, revision) {
      return next.selection is map && next.selection.schemaVersion == 1
        && next.selectionRevision is int && next.selectionRevision == revision + 1;
    }
    // Matching grants combine with OR: explicitly exclude the dedicated ID.
    match /couplePicks/{document} {
      allow read: if siteMember();
      allow write: if siteMember() && document != 'invitation_templates';
    }
    match /couplePicks/invitation_templates {
      allow read: if siteMember();
      allow create: if siteMember() && validInvitation(request.resource.data)
        && ownFavorites(request.resource.data.get('favorites', {}), {})
        && ((!request.resource.data.keys().hasAny(['selection', 'selectionRevision']))
          || validSelection(request.resource.data, 0));
      allow update: if siteMember() && validInvitation(request.resource.data)
        && ownFavorites(request.resource.data.get('favorites', {}), resource.data.get('favorites', {}))
        && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['selection', 'selectionRevision']))
          || validSelection(request.resource.data, resource.data.get('selectionRevision', 0)));
      allow delete: if false;
    }
    function isTripLog(document) {
      return document.matches('honeymoon_2027_(budget_)?log_.*');
    }
    function validTripLog(document) {
      let next = request.resource.data;
      return next.actorUid == request.auth.uid
        && next.actor == (memberRole() == 'sungwoo' ? '성우' : '소희')
        && next.changedAt == request.time && next.tripId == 'honeymoon_2027'
        && next.target is string && next.keys().hasAll(['before', 'after'])
        && ((document.matches('honeymoon_2027_budget_log_.*') && next.type in ['budget', 'ledger'])
          || (document.matches('honeymoon_2027_log_.*') && next.type in ['hotel', 'decision', 'day']));
    }
    match /itineraries/{document} {
      allow read: if siteMember();
      allow create: if siteMember() && document != 'main'
        && (!isTripLog(document) || validTripLog(document));
      allow update, delete: if siteMember() && document != 'main' && !isTripLog(document);
    }
  }
}
